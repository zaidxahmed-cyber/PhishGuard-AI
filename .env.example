# ============================================================
# PhishGuard AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# ── Feature Flags ───────────────────────────────────────────
# Set to true to use LIME for ML explanations (slower but more accurate).
# Default is false (uses faster TF-IDF coefficient fallback).
USE_LIME=false

# ── Gmail API ───────────────────────────────────────────────
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console.
# Download from: https://console.cloud.google.com/ > APIs & Services > Credentials
GMAIL_CREDENTIALS_PATH=./credentials.json

# Path where the OAuth2 token is cached after first-run browser consent.
# This file is auto-generated — never commit it.
GMAIL_TOKEN_PATH=./token.json

# OAuth2 scopes (readonly is sufficient for inbox fetching)
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# ── Model Paths (optional overrides) ────────────────────────
# Override default model file locations if needed.
# ML_VECTORIZER_PATH=./models/tfidf_vectorizer.joblib
# ML_CLASSIFIER_PATH=./models/lr_classifier.joblib
# TRANSFORMER_MODEL_DIR=./models/distilbert-phishing
